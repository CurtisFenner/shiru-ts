{
  "compilerOptions": {
    "target": "ES2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noEmit": true,
    "strict": true,
    "noImplicitOverride": true,
    "allowJs": true,
    "sourceMap": true,
    "inlineSources": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "rootDir": "src/",
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
  },
  "include": [
    "src/*.d.ts",
    "src/shiru/**/*.ts",
    "src/node/**/*.ts"
  ]
}
